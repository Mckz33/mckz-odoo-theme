<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="view_res_config_settings_form" model="ir.ui.view">
        <field name="name">res.config.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='user_default_rights']" position="before">
                <block title="Personalização do Tema" id="branding_settings">

                    <!-- Color Scheme Selection -->
                    <setting string="Esquema de Cores" help="Selecione um esquema de cores predefinido ou personalize o seu">
                        <div class="content-group">
                            <div class="mt-2 mb-3">
                                <label for="color_scheme" string="Esquema de Cores" class="o_light_label"/>
                                <field name="color_scheme" widget="radio" options="{'horizontal': true}"/>
                            </div>

                            <!-- Color Scheme Preview Grid -->
                            <div class="row g-3 mb-3">
                                <!-- Metronic -->
                                <div class="col-md-3 col-sm-6">
                                    <div class="card h-100 mckz_scheme_card" data-scheme="metronic">
                                        <div class="card-body p-2">
                                            <h6 class="card-title mb-2 text-center">Metronic</h6>
                                            <div class="d-flex gap-1 justify-content-center">
                                                <span class="rounded" style="width:20px;height:20px;background:#1B84FF;" title="Marca"></span>
                                                <span class="rounded" style="width:20px;height:20px;background:#7239EA;" title="Primária"></span>
                                                <span class="rounded" style="width:20px;height:20px;background:#17C653;" title="Sucesso"></span>
                                                <span class="rounded" style="width:20px;height:20px;background:#F6C000;" title="Alerta"></span>
                                                <span class="rounded" style="width:20px;height:20px;background:#F8285A;" title="Perigo"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Slate -->
                                <div class="col-md-3 col-sm-6">
                                    <div class="card h-100 mckz_scheme_card" data-scheme="slate">
                                        <div class="card-body p-2">
                                            <h6 class="card-title mb-2 text-center">Ardósia</h6>
                                            <div class="d-flex gap-1 justify-content-center">
                                                <span class="rounded" style="width:20px;height:20px;background:#334155;" title="Marca"></span>
                                                <span class="rounded" style="width:20px;height:20px;background:#3B82F6;" title="Primária"></span>
                                                <span class="rounded" style="width:20px;height:20px;background:#22C55E;" title="Sucesso"></span>
                                                <span class="rounded" style="width:20px;height:20px;background:#EAB308;" title="Alerta"></span>
                                                <span class="rounded" style="width:20px;height:20px;background:#EF4444;" title="Perigo"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Haze -->
                                <div class="col-md-3 col-sm-6">
                                    <div class="card h-100 mckz_scheme_card" data-scheme="haze">
                                        <div class="card-body p-2">
                                            <h6 class="card-title mb-2 text-center">Névoa</h6>
                                            <div class="d-flex gap-1 justify-content-center">
                                                <span class="rounded" style="width:20px;height:20px;background:#6366F1;" title="Marca"></span>
                                                <span class="rounded" style="width:20px;height:20px;background:#8B5CF6;" title="Primária"></span>
                                                <span class="rounded" style="width:20px;height:20px;background:#10B981;" title="Sucesso"></span>
                                                <span class="rounded" style="width:20px;height:20px;background:#F59E0B;" title="Alerta"></span>
                                                <span class="rounded" style="width:20px;height:20px;background:#EF4444;" title="Perigo"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Gray -->
                                <div class="col-md-3 col-sm-6">
                                    <div class="card h-100 mckz_scheme_card" data-scheme="gray">
                                        <div class="card-body p-2">
                                            <h6 class="card-title mb-2 text-center">Cinza</h6>
                                            <div class="d-flex gap-1 justify-content-center">
                                                <span class="rounded" style="width:20px;height:20px;background:#4B5563;" title="Marca"></span>
                                                <span class="rounded" style="width:20px;height:20px;background:#6B7280;" title="Primária"></span>
                                                <span class="rounded" style="width:20px;height:20px;background:#10B981;" title="Sucesso"></span>
                                                <span class="rounded" style="width:20px;height:20px;background:#F59E0B;" title="Alerta"></span>
                                                <span class="rounded" style="width:20px;height:20px;background:#EF4444;" title="Perigo"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Neutral -->
                                <div class="col-md-3 col-sm-6">
                                    <div class="card h-100 mckz_scheme_card" data-scheme="neutral">
                                        <div class="card-body p-2">
                                            <h6 class="card-title mb-2 text-center">Neutro</h6>
                                            <div class="d-flex gap-1 justify-content-center">
                                                <span class="rounded" style="width:20px;height:20px;background:#78716C;" title="Marca"></span>
                                                <span class="rounded" style="width:20px;height:20px;background:#A8A29E;" title="Primária"></span>
                                                <span class="rounded" style="width:20px;height:20px;background:#84CC16;" title="Sucesso"></span>
                                                <span class="rounded" style="width:20px;height:20px;background:#FBBF24;" title="Alerta"></span>
                                                <span class="rounded" style="width:20px;height:20px;background:#F87171;" title="Perigo"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Sage -->
                                <div class="col-md-3 col-sm-6">
                                    <div class="card h-100 mckz_scheme_card" data-scheme="sage">
                                        <div class="card-body p-2">
                                            <h6 class="card-title mb-2 text-center">Sálvia</h6>
                                            <div class="d-flex gap-1 justify-content-center">
                                                <span class="rounded" style="width:20px;height:20px;background:#4D7C0F;" title="Marca"></span>
                                                <span class="rounded" style="width:20px;height:20px;background:#65A30D;" title="Primária"></span>
                                                <span class="rounded" style="width:20px;height:20px;background:#22C55E;" title="Sucesso"></span>
                                                <span class="rounded" style="width:20px;height:20px;background:#EAB308;" title="Alerta"></span>
                                                <span class="rounded" style="width:20px;height:20px;background:#DC2626;" title="Perigo"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Zinc -->
                                <div class="col-md-3 col-sm-6">
                                    <div class="card h-100 mckz_scheme_card" data-scheme="zinc">
                                        <div class="card-body p-2">
                                            <h6 class="card-title mb-2 text-center">Zinco</h6>
                                            <div class="d-flex gap-1 justify-content-center">
                                                <span class="rounded" style="width:20px;height:20px;background:#3F3F46;" title="Marca"></span>
                                                <span class="rounded" style="width:20px;height:20px;background:#71717A;" title="Primária"></span>
                                                <span class="rounded" style="width:20px;height:20px;background:#22C55E;" title="Sucesso"></span>
                                                <span class="rounded" style="width:20px;height:20px;background:#FACC15;" title="Alerta"></span>
                                                <span class="rounded" style="width:20px;height:20px;background:#F43F5E;" title="Perigo"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Mauve -->
                                <div class="col-md-3 col-sm-6">
                                    <div class="card h-100 mckz_scheme_card" data-scheme="mauve">
                                        <div class="card-body p-2">
                                            <h6 class="card-title mb-2 text-center">Malva</h6>
                                            <div class="d-flex gap-1 justify-content-center">
                                                <span class="rounded" style="width:20px;height:20px;background:#7C3AED;" title="Marca"></span>
                                                <span class="rounded" style="width:20px;height:20px;background:#A855F7;" title="Primária"></span>
                                                <span class="rounded" style="width:20px;height:20px;background:#34D399;" title="Sucesso"></span>
                                                <span class="rounded" style="width:20px;height:20px;background:#FCD34D;" title="Alerta"></span>
                                                <span class="rounded" style="width:20px;height:20px;background:#FB7185;" title="Perigo"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </setting>

                    <!-- Light Mode Colors -->
                    <setting string="Cores do Modo Claro" help="Personalize a aparência do modo claro">
                        <div class="content-group">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="d-flex align-items-center mb-2">
                                        <label for="color_brand_light" string="Marca" class="me-auto"/>
                                        <field name="color_brand_light" class="w-25" widget="color"/>
                                    </div>
                                    <div class="d-flex align-items-center mb-2">
                                        <label for="color_primary_light" string="Primária" class="me-auto"/>
                                        <field name="color_primary_light" class="w-25" widget="color"/>
                                    </div>
                                    <div class="d-flex align-items-center mb-2">
                                        <label for="color_info_light" string="Informação" class="me-auto"/>
                                        <field name="color_info_light" class="w-25" widget="color"/>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="d-flex align-items-center mb-2">
                                        <label for="color_success_light" string="Sucesso" class="me-auto"/>
                                        <field name="color_success_light" class="w-25" widget="color"/>
                                    </div>
                                    <div class="d-flex align-items-center mb-2">
                                        <label for="color_warning_light" string="Alerta" class="me-auto"/>
                                        <field name="color_warning_light" class="w-25" widget="color"/>
                                    </div>
                                    <div class="d-flex align-items-center mb-2">
                                        <label for="color_danger_light" string="Perigo" class="me-auto"/>
                                        <field name="color_danger_light" class="w-25" widget="color"/>
                                    </div>
                                </div>
                            </div>
                            <button
                                name="action_reset_light_color_assets"
                                icon="fa-refresh"
                                type="object"
                                string="Restaurar Cores Claras"
                                class="btn-link"
                            />
                        </div>
                    </setting>

                    <!-- Dark Mode Colors -->
                    <setting string="Cores do Modo Escuro" help="Personalize a aparência do modo escuro">
                        <div class="content-group">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="d-flex align-items-center mb-2">
                                        <label for="color_brand_dark" string="Marca" class="me-auto"/>
                                        <field name="color_brand_dark" class="w-25" widget="color"/>
                                    </div>
                                    <div class="d-flex align-items-center mb-2">
                                        <label for="color_primary_dark" string="Primária" class="me-auto"/>
                                        <field name="color_primary_dark" class="w-25" widget="color"/>
                                    </div>
                                    <div class="d-flex align-items-center mb-2">
                                        <label for="color_info_dark" string="Informação" class="me-auto"/>
                                        <field name="color_info_dark" class="w-25" widget="color"/>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="d-flex align-items-center mb-2">
                                        <label for="color_success_dark" string="Sucesso" class="me-auto"/>
                                        <field name="color_success_dark" class="w-25" widget="color"/>
                                    </div>
                                    <div class="d-flex align-items-center mb-2">
                                        <label for="color_warning_dark" string="Alerta" class="me-auto"/>
                                        <field name="color_warning_dark" class="w-25" widget="color"/>
                                    </div>
                                    <div class="d-flex align-items-center mb-2">
                                        <label for="color_danger_dark" string="Perigo" class="me-auto"/>
                                        <field name="color_danger_dark" class="w-25" widget="color"/>
                                    </div>
                                </div>
                            </div>
                            <button
                                name="action_reset_dark_color_assets"
                                icon="fa-refresh"
                                type="object"
                                string="Restaurar Cores Escuras"
                                class="btn-link"
                            />
                        </div>
                    </setting>

                </block>
            </xpath>
        </field>
    </record>

</odoo>
