<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="view_res_config_settings_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.appsbar</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='general_settings']//block[@title='Companies']" position="after">
                <block title="Menu Lateral (AppsBar)" name="appsbar_settings">
                    <setting string="Logo do Menu" company_dependent="1" help="Defina um logo personalizado para o menu lateral">
                        <div class="content-group">
                            <div class="row mt-2">
                                <label class="col-lg-3 o_light_label" for="appbar_image"/>
                                <field name="appbar_image" widget="image" class="oe_avatar" options="{'size': [128, 128]}"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
