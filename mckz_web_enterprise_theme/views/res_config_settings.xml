<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="view_res_config_settings_appsbar_form" model="ir.ui.view">
        <field name="name">res.config.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mckz_web_appsbar.view_res_config_settings_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='appbar_image']/../.." position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_res_config_settings_colors_form" model="ir.ui.view">
        <field name="name">res.config.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mckz_web_colors.view_res_config_settings_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='branding_settings']" position="attributes">
                <attribute name="string">Tema do Sistema</attribute>
            </xpath>

            <!-- Add Border Radius and Density Controls after Color Schemes -->
            <xpath expr="//field[@name='color_scheme']/ancestor::setting" position="after">

                <!-- Border Radius Control -->
                <setting string="Borda Arredondada" help="Controla o arredondamento dos cantos em toda a interface">
                    <div class="content-group">
                        <div class="mt-2">
                            <field name="theme_border_radius" widget="radio" options="{'horizontal': true}"/>
                        </div>
                        <div class="row g-2 mt-3">
                            <div class="col-2 text-center">
                                <div class="border p-3" style="border-radius: 0;">
                                    <small class="text-muted">Nenhum</small>
                                </div>
                            </div>
                            <div class="col-2 text-center">
                                <div class="border p-3" style="border-radius: 4px;">
                                    <small class="text-muted">Pequeno</small>
                                </div>
                            </div>
                            <div class="col-2 text-center">
                                <div class="border p-3" style="border-radius: 8px;">
                                    <small class="text-muted">Médio</small>
                                </div>
                            </div>
                            <div class="col-2 text-center">
                                <div class="border p-3" style="border-radius: 12px;">
                                    <small class="text-muted">Grande</small>
                                </div>
                            </div>
                            <div class="col-2 text-center">
                                <div class="border p-3" style="border-radius: 16px;">
                                    <small class="text-muted">Extra Grande</small>
                                </div>
                            </div>
                            <div class="col-2 text-center">
                                <div class="border p-3" style="border-radius: 24px;">
                                    <small class="text-muted">Máximo</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </setting>

                <!-- Density Control -->
                <setting string="Densidade da Interface" help="Controla o espaçamento e preenchimento dos elementos">
                    <div class="content-group">
                        <div class="mt-2">
                            <field name="theme_density" widget="radio" options="{'horizontal': true}"/>
                        </div>
                        <div class="row g-3 mt-3">
                            <div class="col-4">
                                <div class="card">
                                    <div class="card-body p-2">
                                        <h6 class="card-title small mb-1">Compacto</h6>
                                        <p class="card-text small text-muted mb-0">
                                            Espaçamento reduzido para mais conteúdo. Ideal para usuários avançados.
                                        </p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="card">
                                    <div class="card-body p-3">
                                        <h6 class="card-title small mb-2">Confortável</h6>
                                        <p class="card-text small text-muted mb-0">
                                            Espaçamento equilibrado para uso diário. Opção padrão.
                                        </p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="card">
                                    <div class="card-body p-4">
                                        <h6 class="card-title small mb-3">Espaçoso</h6>
                                        <p class="card-text small text-muted mb-0">
                                            Preenchimento extra para melhor legibilidade. Ideal para acessibilidade.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </setting>

                <!-- Font Family Control -->
                <setting string="Família de Fonte" help="Selecione uma fonte do Google para a tipografia da interface">
                    <div class="content-group">
                        <div class="mt-2">
                            <field name="theme_font_family" widget="selection"/>
                        </div>
                        <div class="row g-2 mt-3">
                            <div class="col-md-3">
                                <div class="card p-2 text-center" style="font-family: system-ui;">
                                    <small>Padrão do Sistema</small>
                                    <strong>Aa Bb Cc</strong>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card p-2 text-center" style="font-family: 'Inter', sans-serif;">
                                    <small>Inter</small>
                                    <strong>Aa Bb Cc</strong>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card p-2 text-center" style="font-family: 'Roboto', sans-serif;">
                                    <small>Roboto</small>
                                    <strong>Aa Bb Cc</strong>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card p-2 text-center" style="font-family: 'Poppins', sans-serif;">
                                    <small>Poppins</small>
                                    <strong>Aa Bb Cc</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </setting>

            </xpath>

            <!-- AppsBar Colors -->
            <xpath expr="//field[@name='color_primary_light']/.." position="after">
                <div class="d-flex align-items-center mb-2">
                    <label for="theme_color_appbar_text_light" string="Texto do Menu" class="me-auto"/>
                    <field name="theme_color_appbar_text_light" class="w-25" widget="color"/>
                </div>
                <div class="d-flex align-items-center mb-2">
                    <label for="theme_color_appbar_active_light" string="Item Ativo" class="me-auto"/>
                    <field name="theme_color_appbar_active_light" class="w-25" widget="color"/>
                </div>
                <div class="d-flex align-items-center mb-2">
                    <label for="theme_color_appbar_background_light" string="Fundo do Menu" class="me-auto"/>
                    <field name="theme_color_appbar_background_light" class="w-25" widget="color"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='color_primary_dark']/.." position="after">
                <div class="d-flex align-items-center mb-2">
                    <label for="theme_color_appbar_text_dark" string="Texto do Menu" class="me-auto"/>
                    <field name="theme_color_appbar_text_dark" class="w-25" widget="color"/>
                </div>
                <div class="d-flex align-items-center mb-2">
                    <label for="theme_color_appbar_active_dark" string="Item Ativo" class="me-auto"/>
                    <field name="theme_color_appbar_active_dark" class="w-25" widget="color"/>
                </div>
                <div class="d-flex align-items-center mb-2">
                    <label for="theme_color_appbar_background_dark" string="Fundo do Menu" class="me-auto"/>
                    <field name="theme_color_appbar_background_dark" class="w-25" widget="color"/>
                </div>
            </xpath>

            <!-- Background Images and Favicon -->
            <xpath expr="//block[@id='branding_settings']" position="inside">
                <setting
                    string="Imagem de Fundo (Modo Claro)"
                    company_dependent="1"
                    help="Defina a imagem de fundo para o menu de aplicativos"
                >
                    <field name="theme_background_image_light" widget="image" class="ml-4 w-75 bg-transparent"/>
                </setting>
                <setting
                    string="Imagem de Fundo (Modo Escuro)"
                    company_dependent="1"
                    help="Defina a imagem de fundo para o menu de aplicativos no modo escuro"
                >
                    <field name="theme_background_image_dark" widget="image" class="ml-4 w-75 bg-transparent"/>
                </setting>
                <setting string="Logo do Menu Lateral" company_dependent="1" help="Defina um logo personalizado para o menu lateral">
                    <div class="w-50 row">
                        <field name="appbar_image" widget="image" class="oe_avatar bg-transparent"/>
                    </div>
                </setting>
                <setting string="Favicon" company_dependent="1" help="Defina seu próprio favicon">
                    <div class="w-50 row">
                        <field name="theme_favicon" widget="image" class="oe_avatar bg-transparent"/>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
